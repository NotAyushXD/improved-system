# ============================================================================
# .env.example — every tunable parameter in the need-state pipeline
#
#   cp .env.example .env      (from the improved-system/ folder)
#
# Then edit .env. Everything here is COMMENTED OUT and shows its DEFAULT, so
# an empty .env behaves exactly like no .env at all. Uncomment only what you
# actually want to change — that way `python src/config.py` shows you a short
# list of your overrides rather than a wall of values.
#
# PRECEDENCE:  real environment variable  >  this file  >  built-in default
# So you can override for a single run without editing anything:
#     PIPELINE_EPOCHS=50 python pipeline_main.py
#
# CHECK WHAT WILL ACTUALLY RUN, before starting an 8-hour job:
#     cd src && python config.py
#
# SYNTAX: KEY=value, one per line. `#` starts a comment. To include a literal
# `#` in a value, quote it: KEY="a # b". Bad values fail at startup with a
# clear message rather than midway through a long run.
#
# .env is in .gitignore — it is yours, per-machine. .env.example is committed.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# PATHS
# ─────────────────────────────────────────────────────────────────────────────
# Where the pipeline WRITES everything (caches, model, embeddings, clusters).
#PIPELINE_OUTPUT_DIR=../data/output
#PIPELINE_DATA_DIR=../data

# The local embedded DuckDB file holding basket storage. Not your warehouse.
#PIPELINE_DUCKDB_PATH=../data/pipeline.duckdb

# Inputs you downloaded by hand from the warehouse. Each may be a single
# .parquet file OR a folder of part-files (the Databricks/Spark export shape).
#PIPELINE_HOUSEHOLD_WEEK_TRAIN=../data/ns_household_tpnb_week_agg_train
#PIPELINE_PRODUCT_ATTRIBUTES_TPNA=../data/ns_item_lookup_tpna
#PIPELINE_TPNB_TO_TPNA_MAPPING=../data/ns_tpnb_to_tpna_mapping


# ─────────────────────────────────────────────────────────────────────────────
# GENERAL
# ─────────────────────────────────────────────────────────────────────────────
# Used for sub-clustering, training-basket sampling, Leiden, and GMM.
# ⚠ Changing this invalidates the sub-cluster and LMDB caches (handled
#   automatically — they fingerprint it and rebuild).
#PIPELINE_SEED=42


# ─────────────────────────────────────────────────────────────────────────────
# PRODUCT EMBEDDINGS  (build_product_embeddings.py — run once, before the rest)
# ─────────────────────────────────────────────────────────────────────────────
# Any sentence-transformers model. Point at a local folder on an offline box.
# Changing this changes the embedding width and invalidates EVERYTHING
# downstream — delete data/output/ and retrain.
#PIPELINE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# "All-but-the-top" anisotropy correction: removes the top N principal
# components after mean-centering. Helps for short, domain-homogeneous retail
# text. N=2 was carried over from prior work and NOT re-validated on this
# product set — worth checking clustering quality with and without.
#PIPELINE_APPLY_ANISOTROPY_CORRECTION=true
#PIPELINE_N_TOP_PCS_TO_REMOVE=2


# ─────────────────────────────────────────────────────────────────────────────
# BASKET CONSTRUCTION
# ─────────────────────────────────────────────────────────────────────────────
# Baskets with fewer than this many distinct products are dropped. Below 2, a
# basket has no co-purchase pair at all and carries no signal.
#PIPELINE_MIN_BASKET_PRODUCTS=2

# Purely a log warning if the basket count looks unexpectedly large.
#PIPELINE_BASKET_COUNT_WARN_THRESHOLD=2000000


# ─────────────────────────────────────────────────────────────────────────────
# GRAPH CONSTRUCTION  (GraphBuilder.py)
# ⚠ Everything in this block is fingerprinted into the LMDB training-graph
#   manifest. Change any of it and the cache rebuilds automatically.
# ─────────────────────────────────────────────────────────────────────────────
# Max co-purchase edges kept per node, within each basket. Higher = denser
# graphs, more memory and slower message passing.
#PIPELINE_TOP_K=10

# Global product sub-clustering across the WHOLE catalog (no category
# pre-grouping). K is chosen from these candidates by silhouette score.
# Tune to catalog size: a few hundred products wants small values, a few
# hundred thousand wants roughly what is here.
#PIPELINE_SUBCL_K_CANDIDATES=50,100,200,400
#PIPELINE_SUBCL_N_INIT=5
#PIPELINE_SUBCL_BATCH_SIZE=4096
# Silhouette is evaluated on a sample, not the whole catalog — its own cost
# grows with the sample it is given.
#PIPELINE_SUBCL_SIL_SAMPLE=5000


# ─────────────────────────────────────────────────────────────────────────────
# CO-PURCHASE MATRIX
# ─────────────────────────────────────────────────────────────────────────────
# Built in row-chunks of this many baskets, checkpointed after each chunk.
# Lower this if you see memory pressure; raise it for fewer, faster chunks.
# Does NOT change the result — X.T @ X is exactly additive over row-disjoint
# chunks (there is a test for this).
#PIPELINE_COPURCHASE_CHUNK_BASKETS=500000


# ─────────────────────────────────────────────────────────────────────────────
# GNN TRAINING  (GNN_Train.py)
# ⚠ Changing any of these means the saved model no longer matches. Delete
#   basket_gnn_model.pt and basket_gnn_embeddings.parquet, and retrain.
# ─────────────────────────────────────────────────────────────────────────────
#PIPELINE_HIDDEN_DIM=128
# Width of the final basket embedding — the space need-states are found in.
#PIPELINE_OUT_DIM=64
#PIPELINE_DROPOUT=0.1
# Must stay 2: _build_edges_numba emits exactly 2 edge features.
#PIPELINE_EDGE_DIM=2
#PIPELINE_TRAIN_BATCH=256
#PIPELINE_EPOCHS=20
# Reduced from 1e-3 — prevents divergence with the current feature set.
#PIPELINE_LR=0.0001
#PIPELINE_WEIGHT_DECAY=0.00001
# Training baskets sampled (stratified by basket size). With the LMDB-backed
# dataset this is no longer a hard RAM constraint — raise it freely.
#PIPELINE_N_TRAIN_SAMPLES=300000
# DataLoader workers. Forced to 0 on Windows by default (spawn re-imports the
# launching module in every worker).
#PIPELINE_NUM_WORKERS=4

# Inference streams the full basket population in restartable chunks.
#PIPELINE_INFERENCE_CHUNK_BASKETS=50000
#PIPELINE_INFERENCE_BATCH_SIZE=8192
# A 'running' chunk older than this is considered crashed and reclaimable.
#PIPELINE_CHUNK_STALE_AFTER_SECONDS=3600
# LMDB map size is a VIRTUAL address-space bound, not pre-allocated disk.
#PIPELINE_LMDB_MAP_SIZE_GB=200


# ─────────────────────────────────────────────────────────────────────────────
# CLUSTERING INTO NEED-STATES
# ─────────────────────────────────────────────────────────────────────────────
# Neighbours per basket before the mutual-kNN filter.
#PIPELINE_BASKET_KNN_K=15
# Mutual-kNN: an edge survives only if BOTH baskets rank each other in top-K.
# Turning this off produces a much denser, hub-dominated graph.
#PIPELINE_USE_MUTUAL_KNN=true

# Leiden resolution. Higher = more, smaller need-states. THIS IS A STARTING
# POINT, not a tuned value — run cluster_basket_embeddings.sweep_resolution()
# and read the table before trusting it.
#PIPELINE_LEIDEN_RESOLUTION=1.0

# GMM components. ALSO A PLACEHOLDER — replace with your team's real best-K
# logic, or eyeball select_k_via_bic() first.
#PIPELINE_GMM_N_COMPONENTS=30
# Range swept by select_k_via_bic() (it reports, it does not auto-pick).
#PIPELINE_GMM_K_MIN=5
#PIPELINE_GMM_K_MAX=60
#PIPELINE_GMM_K_STEP=5
#PIPELINE_GMM_N_INIT=3
# full | tied | diag | spherical. "diag" scales to more dimensions safely.
#PIPELINE_GMM_COVARIANCE=diag

# Neighbours voting when assigning a NEW basket to an existing Leiden cluster
# (Leiden is transductive and cannot place new points natively).
#PIPELINE_ASSIGN_NEW_BASKET_K=15


# ─────────────────────────────────────────────────────────────────────────────
# NEED-STATE GRAPHS  (need_state_graph.py — Stage 2.5)
# ─────────────────────────────────────────────────────────────────────────────
# Write the raw basket-level kNN edge list? This is what lets you drill from a
# need-state adjacency down to the specific neighbouring baskets behind it.
#PIPELINE_WRITE_BASKET_EDGES=true
# Refuse to write more than this many basket edges. At full population the kNN
# graph can exceed 1B edges — hundreds of GB. Above the cap the write is
# skipped with a message. The need-state-grain tables are always tiny.
#PIPELINE_BASKET_EDGE_WRITE_CAP=50000000

# How a household's consecutive weeks become a transition:
#   1      only genuinely consecutive calendar weeks
#   none   consecutive OBSERVED baskets, however far apart (far more
#          transitions, but conflates a 1-week and a 6-week step)
# Households do not shop every week, so `none` gives much denser journeys.
#PIPELINE_TRANSITION_MAX_WEEK_GAP=1

# Transitions seen fewer times than this are flagged `low_support`, not
# dropped. With a ~8-week window, thin cells are expected.
#PIPELINE_MIN_TRANSITION_SUPPORT=30

# Journey projection: how many weeks ahead, and how many partial paths to
# carry at each step.
#PIPELINE_JOURNEY_DEPTH=3
#PIPELINE_JOURNEY_BEAM=5


# ─────────────────────────────────────────────────────────────────────────────
# DATASET TAGS  (keep train/score tables separate in the same DuckDB file)
# ─────────────────────────────────────────────────────────────────────────────
# Must be plain lowercase identifiers — they become table names.
#PIPELINE_TRAIN_DATASET_TAG=train
#PIPELINE_SCORE_DATASET_TAG=score

# ═════════════════════════════════════════════
# CLUSTERING — Leiden iterations + edge cache  (cluster_basket_embeddings.py)
# ═════════════════════════════════════════════

# Leiden optimiser iterations. leidenalg's own find_partition default is 2;
# run_leiden_on_basket_graph drives the optimiser one iteration at a time so
# each can report progress, which needs the count stated explicitly.
# PIPELINE_LEIDEN_N_ITERATIONS=2

# Reuse (and write) the Stage 2 kNN edge list at
# data/output/basket_knn_edges.parquet, fingerprinted against k, mutual-kNN,
# seed, basket count, backend and a digest of the embeddings. The neighbour
# search is the most expensive thing Stage 2 does; caching it means a Stage 2
# that dies in Leiden or GMM does not repeat it. Costs a few GB of disk.
# PIPELINE_CACHE_BASKET_EDGES=true

# ═════════════════════════════════════════════
# PROGRESS REPORTING  (cluster_basket_embeddings.py)
# ═════════════════════════════════════════════

# Seconds between "still running, N elapsed" heartbeats during long Stage 2
# steps. Raise it if it makes a captured log noisy.
# PIPELINE_PROGRESS_HEARTBEAT_SECS=30
