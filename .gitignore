# ── Virtual environments ──
.venv/
venv/
env/
ENV/

# ── Local configuration ──
# .env is per-machine (paths, tuning). .env.example IS committed — it is the
# documented template every parameter is described in.
.env
.env.*
!.env.example

# ── Data folder ──
data/*
!data/TABLE_REFERENCE.md
!data/*.sql

# ── Runtime artifacts (generated by the pipeline) ──
src/*.parquet
src/*.npz
src/*.pkl
src/*.pt
src/*.csv

# ── Python cache ──
__pycache__/
*.py[cod]
*.pyo

# ── Jupyter checkpoints ──
.ipynb_checkpoints/

# ── OS files ──
.DS_Store
Thumbs.db
