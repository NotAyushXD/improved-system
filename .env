# ============================================================================
# .env — ACTIVE configuration. Gitignored; per-machine.
#
# These are live values, not a template. Edit them directly.
#
# BEFORE A LONG RUN, check what will actually be used:
#     cd src && python config.py
#
# OVERRIDE FOR ONE RUN without editing this file (a real env var wins):
#     PIPELINE_EPOCHS=50 python pipeline_main.py
#
# RUN ORDER:
#     cd src
#     python build_product_embeddings.py     # once — builds product vectors
#     python pipeline_main.py                 # baskets -> GNN -> need-states -> graphs
#     python score_new_baskets.py --new-transactions ../data/ns_household_tpnb_week_agg_score
#
# Every value below is the tested default EXCEPT ONE, marked [CHANGED] with
# the reason. Full per-parameter documentation lives in .env.example.
# ============================================================================


# ════════════════════════════════════════════════════════════════════════════
#  INPUT / OUTPUT PATHS
#  Each input may be a single .parquet file OR a folder of part-files (the
#  Databricks/Spark export shape). Relative paths resolve from src/.
# ════════════════════════════════════════════════════════════════════════════

PIPELINE_HOUSEHOLD_WEEK_TRAIN=../data/ns_household_tpnb_week_agg_train
PIPELINE_PRODUCT_ATTRIBUTES_TPNA=../data/ns_item_lookup_tpna
PIPELINE_TPNB_TO_TPNA_MAPPING=../data/ns_tpnb_to_tpna_mapping

PIPELINE_DATA_DIR=../data
PIPELINE_OUTPUT_DIR=../data/output

# Local embedded DuckDB file for basket storage. NOT your warehouse.
# Put this on a fast local disk, not a network/OneDrive-synced folder —
# it takes millions of small random reads during inference.
PIPELINE_DUCKDB_PATH=../data/pipeline.duckdb


# ════════════════════════════════════════════════════════════════════════════
#  GENERAL
# ════════════════════════════════════════════════════════════════════════════

# Used for sub-clustering, training-basket sampling, Leiden and GMM.
# Changing this rebuilds the sub-cluster and LMDB caches automatically.
PIPELINE_SEED=42


# ════════════════════════════════════════════════════════════════════════════
#  PRODUCT EMBEDDINGS   (build_product_embeddings.py — run once, first)
# ════════════════════════════════════════════════════════════════════════════

# On an offline prod box, download the model once and point this at the local
# folder instead, e.g. PIPELINE_EMBEDDING_MODEL=../models/miniLMV6L2
# Changing the model changes embedding width and invalidates EVERYTHING
# downstream — delete data/output/ and retrain.
PIPELINE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# "All-but-the-top" anisotropy correction. N=2 was carried over from prior
# work and NOT re-validated on this product set — worth testing both ways.
PIPELINE_APPLY_ANISOTROPY_CORRECTION=true
PIPELINE_N_TOP_PCS_TO_REMOVE=2


# ════════════════════════════════════════════════════════════════════════════
#  BASKET CONSTRUCTION
# ════════════════════════════════════════════════════════════════════════════

# Below 2 a basket has no co-purchase pair at all and carries no signal.
PIPELINE_MIN_BASKET_PRODUCTS=2

# Log-only warning threshold on basket count.
PIPELINE_BASKET_COUNT_WARN_THRESHOLD=2000000


# ════════════════════════════════════════════════════════════════════════════
#  GRAPH CONSTRUCTION   (GraphBuilder.py)
#  Every value in this block is fingerprinted into the LMDB training-graph
#  manifest — change one and the cache rebuilds automatically. Correct, but
#  not free: know you are triggering a rebuild.
# ════════════════════════════════════════════════════════════════════════════

# Max co-purchase edges kept per node, within each basket.
PIPELINE_TOP_K=10

# Global product sub-clustering across the WHOLE catalog (no category
# pre-grouping). K is chosen from these candidates by silhouette score.
# These candidates suit a catalog of ~100k-300k products. For a much smaller
# catalog, shift the range down (e.g. 20,50,100).
PIPELINE_SUBCL_K_CANDIDATES=50,100,200,400
PIPELINE_SUBCL_N_INIT=5
PIPELINE_SUBCL_BATCH_SIZE=4096
# Silhouette is scored on a sample — its own cost grows with what it is given.
PIPELINE_SUBCL_SIL_SAMPLE=5000


# ════════════════════════════════════════════════════════════════════════════
#  CO-PURCHASE MATRIX
# ════════════════════════════════════════════════════════════════════════════

# Built in row-chunks, checkpointed after each. Lower this FIRST if you hit
# memory pressure. Does not change the result — X.T @ X is exactly additive
# over row-disjoint chunks (there is a test proving this).
PIPELINE_COPURCHASE_CHUNK_BASKETS=500000


# ════════════════════════════════════════════════════════════════════════════
#  GNN TRAINING   (GNN_Train.py)
#  Changing any of these means the saved model no longer matches. Delete
#  basket_gnn_model.pt and basket_gnn_embeddings.parquet, then retrain.
# ════════════════════════════════════════════════════════════════════════════

PIPELINE_HIDDEN_DIM=128
# Width of the final basket embedding — the space need-states are found in.
PIPELINE_OUT_DIM=64
PIPELINE_DROPOUT=0.1
# Must stay 2 — _build_edges_numba emits exactly 2 edge features. Any other
# value is rejected at startup rather than crashing at the first GINEConv.
PIPELINE_EDGE_DIM=2
PIPELINE_TRAIN_BATCH=256
PIPELINE_EPOCHS=20
# Reduced from 1e-3 — prevents divergence with the current feature set.
PIPELINE_LR=0.0001
PIPELINE_WEIGHT_DECAY=0.00001

# Training baskets sampled, stratified by basket size. The LMDB-backed dataset
# means this is no longer a RAM constraint — raising it costs build time and
# disk, not memory. 300k is the tested value; raise it if need-states look
# unstable across runs.
PIPELINE_N_TRAIN_SAMPLES=300000

# ── DELIBERATELY LEFT UNSET ────────────────────────────────────────────────
# PIPELINE_NUM_WORKERS is the ONLY parameter whose default is platform-aware:
# 0 on Windows, 4 elsewhere. On Windows the `spawn` start method re-imports
# the launching module in every worker process. pipeline_main.py has the
# required `if __name__ == "__main__"` guard, so workers are safe there — but
# hardcoding a number here would silently change behaviour depending on which
# OS this file is copied to. Leave it unset unless you are tuning throughput
# on a known machine.
#PIPELINE_NUM_WORKERS=4


# ════════════════════════════════════════════════════════════════════════════
#  INFERENCE  (restartable chunk queue — a crash resumes, it does not restart)
# ════════════════════════════════════════════════════════════════════════════

PIPELINE_INFERENCE_CHUNK_BASKETS=50000
PIPELINE_INFERENCE_BATCH_SIZE=2048
# A 'running' chunk older than this is treated as crashed and reclaimable.
PIPELINE_CHUNK_STALE_AFTER_SECONDS=3600
# LMDB map size is a VIRTUAL address-space bound, not pre-allocated disk —
# safe to size generously.
PIPELINE_LMDB_MAP_SIZE_GB=200


# ════════════════════════════════════════════════════════════════════════════
#  CLUSTERING INTO NEED-STATES
# ════════════════════════════════════════════════════════════════════════════

# Neighbours per basket before the mutual-kNN filter.
PIPELINE_BASKET_KNN_K=15
# An edge survives only if BOTH baskets rank each other in top-K. Turning this
# off gives a much denser, hub-dominated graph.
PIPELINE_USE_MUTUAL_KNN=true

# ⚠ STARTING POINT, NOT A TUNED VALUE. Higher = more, smaller need-states.
# Before trusting your first run, do this:
#     from cluster_basket_embeddings import build_basket_knn_graph, sweep_resolution
#     sweep_resolution(build_basket_knn_graph(embeddings))
# It reports n_clusters/modularity per resolution and deliberately does NOT
# auto-pick. Then set the value here.
PIPELINE_LEIDEN_RESOLUTION=1.0

# ⚠ PLACEHOLDER — flagged as such in the code; not your team's real best-K
# logic. cluster_basket_embeddings.select_k_via_bic() sweeps K and reports
# BIC/AIC if you want to eyeball it first.
PIPELINE_GMM_N_COMPONENTS=30
PIPELINE_GMM_K_MIN=5
PIPELINE_GMM_K_MAX=60
PIPELINE_GMM_K_STEP=5
PIPELINE_GMM_N_INIT=3
# full | tied | diag | spherical. "diag" scales to more dimensions safely.
PIPELINE_GMM_COVARIANCE=diag

# Neighbours voting when placing a NEW basket into an existing Leiden cluster
# (Leiden is transductive and cannot place new points natively).
PIPELINE_ASSIGN_NEW_BASKET_K=15


# ════════════════════════════════════════════════════════════════════════════
#  NEED-STATE GRAPHS   (Stage 2.5 — adjacency, transitions, journeys)
# ════════════════════════════════════════════════════════════════════════════

# [CHANGED from the default of 1 — the one deliberate deviation in this file]
#
#   1     = count a transition only between genuinely CONSECUTIVE weeks
#   none  = count one between consecutive OBSERVED baskets, however far apart
#
# Set to `none` because of your actual data window. The training SQL covers
# ~2 periods (~8 weeks), and households do not shop every week — so with
# max_week_gap=1 most households contribute almost no transitions and the
# journey graph comes out too sparse to read. `none` uses every consecutive
# pair of baskets a household actually has.
#
# The trade-off is real: it treats a 1-week step and a 6-week step as the same
# transition. Mitigation is built in — every row of
# need_state_transitions.parquet carries `avg_week_gap`, so you can see which
# transitions are being stretched. Check that column before quoting anything.
#
# Set this back to 1 once the SQL window is widened — that is the proper fix,
# and the single highest-value change you can make to the journey work.
PIPELINE_TRANSITION_MAX_WEEK_GAP=none

# Transitions seen fewer times than this are FLAGGED via the `low_support`
# column, not dropped. With a short window, thin cells are expected.
PIPELINE_MIN_TRANSITION_SUPPORT=30

# Journey projection: weeks ahead, and partial paths carried per step.
# Beyond ~3 steps a first-order Markov projection is not worth much on 8 weeks
# of data — see the caveat in need_state_graph.possible_journeys().
PIPELINE_JOURNEY_DEPTH=3
PIPELINE_JOURNEY_BEAM=5

# Write the raw basket-level kNN edge list — this is what lets you drill from
# a need-state adjacency down to the specific neighbouring baskets behind it.
PIPELINE_WRITE_BASKET_EDGES=true

# EXPECT THIS TO REFUSE AT FULL SCALE, and that is correct behaviour.
# At tens of millions of baskets x k=15, the mutual-kNN graph can exceed 50M
# edges, and the write is skipped with a printed message rather than filling
# the disk with hundreds of GB. The need-state-grain tables are always written
# and are tiny. Raise this only if you have confirmed the disk headroom.
PIPELINE_BASKET_EDGE_WRITE_CAP=50000000


# ════════════════════════════════════════════════════════════════════════════
#  DATASET TAGS   (keep train/score tables separate inside one DuckDB file)
#  Must be plain lowercase identifiers — they become table names.
# ════════════════════════════════════════════════════════════════════════════

PIPELINE_TRAIN_DATASET_TAG=train
PIPELINE_SCORE_DATASET_TAG=score
